# Bits application, one colour of a blue/green pair.
#
# deploy.sh renders this into bits-blue.container or bits-green.container,
# filling in the colour, its port and the image. bits-proxy picks which colour
# serves port 3000, and starts it at boot.

[Unit]
Description=Bits application (@COLOUR@)
After=network-online.target bits-postgres.service bits-transactor.service bits-jaeger.service
Requires=bits-postgres.service bits-transactor.service
Wants=bits-jaeger.service

[Container]
Image=@IMAGE@
ContainerName=bits-@COLOUR@

# Network: internal for postgres; HTTP on the colour's own port
Network=bits.network
PublishPort=127.0.0.1:@PORT@:3000

# Environment: ragenix secrets (configured in setup project)
EnvironmentFile=/run/agenix/bits-environment-file

# OTEL traces/metrics → Jaeger
Environment=OTEL_EXPORTER_OTLP_ENDPOINT=http://bits-jaeger:4317

# JVM memory (JAVA_TOOL_OPTIONS is picked up automatically by the JVM)
Environment=JAVA_TOOL_OPTIONS=-Xms512m -Xmx2g

# Security hardening
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL

# JVM needs /tmp for temp files
Tmpfs=/tmp:size=128m,mode=1777

# Resource limits
Memory=4G
PidsLimit=256

[Service]
Restart=always
# The JVM exits 143 on SIGTERM; a deploy stopping the old colour is not a failure.
SuccessExitStatus=143
TimeoutStartSec=180
TimeoutStopSec=30
